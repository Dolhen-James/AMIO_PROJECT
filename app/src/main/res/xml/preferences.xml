<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:title="General Settings"
        android:key="pref_general">

        <CheckBoxPreference
            android:key="pref_service_enabled"
            android:title="Enable Service"
            android:summary="Enable or disable the background service"
            android:defaultValue="false" />

        <CheckBoxPreference
            android:key="pref_boot_start"
            android:title="Start on Boot"
            android:summary="Automatically start service when device boots"
            android:defaultValue="true"
            android:dependency="pref_service_enabled" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="Notification Settings"
        android:key="pref_notifications_notif">

        <CheckBoxPreference
            android:key="pref_notifications_enabled_notif"
            android:title="Enable Notifications"
            android:summary="Show notifications for sensor alerts"
            android:defaultValue="true" />

        <CheckBoxPreference
            android:key="pref_vibrate_notif"
            android:title="Vibrate"
            android:summary="Vibrate on notifications"
            android:defaultValue="true"
            android:dependency="pref_notifications_enabled_notif" />

        <MultiSelectListPreference
            android:key="pref_notification_days_notif"
            android:title="Notification Days"
            android:summary="Select days to receive notifications"
            android:entries="@array/days_of_week"
            android:entryValues="@array/days_of_week_values"
            android:defaultValue="@array/days_of_week_default" 
            />

        <com.example.amio.TimeRangePreference
            android:key="pref_notification_time_range_notif"
            android:title="Notification Time Range"
            android:summary="Select start and end time for notifications"
            android:defaultValue="18:00-23:00" 
            />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="Email Notification Settings"
        android:key="pref_email_notifications">

        <CheckBoxPreference
            android:key="pref_email_notifications_enabled"
            android:title="Enable Email Notifications"
            android:summary="Send email notifications for sensor alerts"
            android:defaultValue="false" />

        <EditTextPreference
            android:key="pref_email_recipient"
            android:title="Recipient Email"
            android:summary="Email address to receive notifications"
            android:defaultValue=""
            android:inputType="textEmailAddress"
            android:dependency="pref_email_notifications_enabled" />


        <MultiSelectListPreference
            android:key="pref_email_notification_days"
            android:title="Email Notification Days"
            android:summary="Select days to receive email notifications"
            android:entries="@array/days_of_week"
            android:entryValues="@array/days_of_week_values"
            android:defaultValue="@array/days_of_week_default"
            android:dependency="pref_email_notifications_enabled" />

        <com.example.amio.TimeRangePreference
            android:key="pref_email_notification_time_range"
            android:title="Email Notification Time Range"
            android:summary="Select start and end time for email notifications"
            android:defaultValue="18:00-23:00"
            android:dependency="pref_email_notifications_enabled" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="Service Settings"
        android:key="pref_service">

        <EditTextPreference
            android:key="pref_polling_interval"
            android:title="Polling Interval"
            android:summary="Time between sensor data fetches (in seconds)"
            android:defaultValue="10"
            android:inputType="number" />

        <EditTextPreference
            android:key="pref_server_url"
            android:title="Server URL"
            android:summary="URL of the sensor data server"
            android:defaultValue="http://192.168.1.100:8080"
            android:inputType="textUri" />

    </PreferenceCategory>

</PreferenceScreen>
